<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_config_view_form_inherit_l10n_do" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.l10n_do</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('row','mt16','o_settings_container')][last()]" position="after">
                <div class="row mt16 o_settings_container">
                    <div class="col-md-12">
                        <h2>Configuración Fiscal Dominicana</h2>
                        <setting>
                            <field name="l10n_do_fiscal_journal_id" readonly="has_active_session"/>
                            <div class="text-muted">
                                Seleccione el diario contable para documentos fiscales. Debe tener habilitado "Usar documentos" de LATAM.
                            </div>
                        </setting>
                        <setting>
                            <field name="l10n_do_default_partner_id" readonly="has_active_session"/>
                            <div class="text-muted">
                                Cliente predeterminado para vendedores de consumo (B02) sin cliente específico.
                            </div>
                        </setting>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="pos_config_view_list_inherit_l10n_do" model="ir.ui.view">
        <field name="name">pos.config.tree.inherit.l10n_do</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='last_session_closing_date']" position="after">
                <field name="l10n_do_fiscal_journal_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
