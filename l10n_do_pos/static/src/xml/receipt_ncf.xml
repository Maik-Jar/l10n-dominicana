<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_do_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <t t-if="order.l10n_do_ncf">
                <div class="text-break pt-3 border-top">
                    <div class="fw-bold">Comprobante Fiscal (NCF)</div>
                    <div><strong>NCF:</strong> <t t-out="order.l10n_do_ncf"/></div>
                    <div><strong>Tipo:</strong> <t t-out="order.l10n_do_ncf_type"/></div>
                    <t t-if="order.partner_id and order.partner_id.vat">
                        <div><strong>RNC Cliente:</strong> <t t-out="order.partner_id.vat"/></div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

</templates>
