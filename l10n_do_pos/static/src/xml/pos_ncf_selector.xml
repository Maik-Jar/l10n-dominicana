<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_do_pos.PaymentScreenNCFInfo" owl="1">
        <div class="payment-methods-row" t-if="order.l10n_do_ncf">
            <div class="col-md-12">
                <div class="payment-info-section">
                    <span class="payment-method-label">NCF</span>
                    <span class="payment-method-value" t-text="order.l10n_do_ncf"/>
                </div>
                <div class="payment-info-section">
                    <span class="payment-method-label">Tipo</span>
                    <span class="payment-method-value" t-text="order.l10n_do_ncf_type"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="l10n_do_pos.OrderSummaryNCF" owl="1">
        <div class="order-summary-ncf" t-if="order.l10n_do_ncf">
            <div class="ncf-display">
                <strong>NCF:</strong>
                <span t-text="order.l10n_do_ncf"/>
                <span class="ncf-type" t-text="'(' + order.l10n_do_ncf_type + ')'"/>
            </div>
        </div>
    </t>

</templates>
